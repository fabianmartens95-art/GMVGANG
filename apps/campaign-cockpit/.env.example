# HTTP Basic protection for the internal cockpit
COCKPIT_BASIC_USER=gmvgang
COCKPIT_BASIC_PASSWORD=replace-with-strong-password

# Shared secret accepted only by /api/sync/raw/*
COCKPIT_SYNC_SECRET=replace-with-random-sync-secret

# Runtime metadata / future direct Notion adapter
NOTION_CREATOR_DATA_SOURCE_ID=replace-with-company-os-creator-data-source-id
NOTION_CAMPAIGN_DATA_SOURCE_ID=replace-with-campaign-data-source-id
NOTION_ASSIGNMENT_DATA_SOURCE_ID=replace-with-assignment-data-source-id

# Optional future direct Notion adapter. Never commit the real token.
NOTION_API_KEY=
