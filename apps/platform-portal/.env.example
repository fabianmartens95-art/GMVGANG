# Development-preview only. These variables are ignored in production session authorization.
# Allowed roles: founder, admin, creator_manager, brand_manager, closer, creator, brand_member
VITE_PLATFORM_DEV_ROLE=creator
VITE_PLATFORM_DEV_ORGANIZATION_ID=
# Set to 1 only for a clearly labeled synthetic Brand Workspace preview in local DEV.
VITE_PLATFORM_DEV_BRAND_DEMO=0

# Browser-safe Supabase identifiers. Never put the service-role key in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The browser renders the current privacy version; the server remains authoritative and rejects mismatches.
VITE_CREATOR_PRIVACY_NOTICE_VERSION=

# Server-only production runtime. These values must be configured as hosting secrets/environment variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREATOR_PRIVACY_NOTICE_VERSION=
