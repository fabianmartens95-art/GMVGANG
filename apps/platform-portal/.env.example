# === Production server runtime ===
# Server-only. NEVER prefix the service role key with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CREATOR_PRIVACY_NOTICE_VERSION=
PORT=4173

# === Browser-public auth configuration ===
# These values are embedded into the Vite browser build and therefore must not contain secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Must match CREATOR_PRIVACY_NOTICE_VERSION for Creator Join to succeed.
VITE_CREATOR_PRIVACY_NOTICE_VERSION=

# === Development-preview only ===
# Allowed roles: founder, admin, creator_manager, brand_manager, closer, creator, brand_member
VITE_PLATFORM_DEV_ROLE=creator
VITE_PLATFORM_DEV_ORGANIZATION_ID=
# Set to 1 only for a clearly labeled synthetic Brand Workspace preview in local DEV.
VITE_PLATFORM_DEV_BRAND_DEMO=0
