    "brand": {
      "priority": 1,
      "owns": [
        "apps/platform-portal/src/brand-",
        "packages/brand-"
      ],
      "blocks": [],
      "productionGate": false
    },
    "commerce": {
      "priority": 1,
      "owns": [
        "packages/economics/",
        "packages/affiliate-performance/",
        "packages/campaign-"
      ],
      "blocks": [],
      "productionGate": false
    },
    "web": {
      "priority": 2,
      "owns": [
        "apps/marketing-site/"
      ],
      "blocks": [],
      "productionGate": false
    },
    "devops": {
      "priority": 0,
      "owns": [
        ".github/",
        ".gmvgang/",
        "scripts/ci/",
        "railway",
        "Dockerfile"
      ],
      "blocks": [],
