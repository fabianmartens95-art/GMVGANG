# Never commit real credentials.

# GMVGANG Platform runtime
NODE_ENV=development
PORT=3000
PLATFORM_PUBLIC_ORIGIN=http://localhost:3000
PLATFORM_PORTAL_DIST_DIR=apps/platform-portal/dist

# Supabase server configuration.
# SUPABASE_PUBLISHABLE_KEY is safe to identify the project, but GMVGANG still keeps
# authentication calls behind the same-origin server in the current web client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret. Server/Railway only. Never expose through VITE_* or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Must match the currently published Creator registration privacy notice.
CREATOR_PRIVACY_NOTICE_VERSION=
# Public build-time identifier used only to render the Creator Join form.
VITE_CREATOR_PRIVACY_NOTICE_VERSION=

# Preferred Creator Workspace source: sanitized Company OS snapshots delivered by Make.
# Server/Railway only. Use at least 32 random characters and send it only in
# X-Company-OS-Sync-Secret to /api/internal/company-os-sync/{creators|campaigns|assignments}.
COMPANY_OS_SYNC_SECRET=

# Shared server-side Notion authorization. A token alone activates no feature.
# Each data source below independently enables its corresponding server path.
# NOTION_TOKEN must never use a VITE_* prefix.
NOTION_TOKEN=
# Optional Company OS > Creator writeback/profile-link source.
NOTION_CREATOR_DATA_SOURCE_ID=
# Legacy/fallback direct read-only Company OS > Assignments source for Creator Portal.
# Prefer COMPANY_OS_SYNC_SECRET so the Portal reuses the existing PII-minimized snapshot path.
NOTION_ASSIGNMENT_DATA_SOURCE_ID=

# Affiliate Performance Brand reads are deliberately OFF by default.
# Do not uncomment until the pending Supabase migration has been deliberately activated,
# supabase/verify/affiliate_performance_store.sql passes, security advisors were reviewed,
# and the chosen thresholds have been explicitly approved.
# AFFILIATE_PERFORMANCE_READ_ENABLED=1
# AFFILIATE_PERFORMANCE_SCHEMA_VERIFIED=1
# AFFILIATE_PERFORMANCE_LOOKBACK_DAYS=30
# AFFILIATE_PERFORMANCE_MAX_RECORDS=200
# AFFILIATE_PERFORMANCE_MIN_COVERAGE_RATIO=1
# AFFILIATE_PERFORMANCE_MAX_SOURCE_AGE_MINUTES=60
# AFFILIATE_PERFORMANCE_REQUIRED_METRICS=gmv,orders